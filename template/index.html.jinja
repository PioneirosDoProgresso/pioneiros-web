<!doctype html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="{{ site.theme_color }}">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.description }}">
<style>
:root{--w950:#26080b;--w900:#3c0c11;--w800:#54131a;--w700:#741f27;--g700:#8f6631;--g500:#caa56e;--g300:#e1c99f;--paper:#f4eddf;--ink:#2f221e;--muted:#725f55;--line:rgba(139,98,49,.32);--shell:min(1260px,calc(100vw - 40px))}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);font-family:Georgia,"Times New Roman",serif;background:radial-gradient(circle at 10% 8%,rgba(202,165,110,.22),transparent 26rem),linear-gradient(180deg,#e9decc,#f7f1e7 42%,#e9dfcf)}a{color:inherit}img{max-width:100%;display:block}.shell{width:var(--shell);margin:auto}
.site-header{position:sticky;top:0;z-index:20;background:rgba(60,12,17,.96);color:#fff8ec;border-bottom:1px solid rgba(225,201,159,.25);backdrop-filter:blur(16px)}.nav{position:relative;min-height:76px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:28px}.brand{display:flex;align-items:center;gap:13px;text-decoration:none}.brand-mark{width:43px;height:43px;display:grid;place-items:center;overflow:hidden;border:1px solid var(--g500);border-radius:50%;color:var(--g300)}.brand-logo,.footer-logo{display:block;object-fit:contain;transform:scale(2.3);transform-origin:center;filter:brightness(0) saturate(100%) invert(78%) sepia(26%) saturate(542%) hue-rotate(356deg) brightness(92%) contrast(88%)}.brand-logo{width:28px;height:28px}.brand-copy strong,.brand-copy span{display:block}.brand-copy strong{font-size:.86rem;letter-spacing:.08em;text-transform:uppercase}.brand-copy span{color:var(--g300);font-size:.69rem}.nav-links{display:flex;justify-content:center;gap:6px}.nav-links a{padding:10px 13px;border-radius:999px;color:#e9d9c1;font-size:.82rem;font-weight:700;text-decoration:none}.nav-links a:hover{background:rgba(255,255,255,.06)}.nav-actions{display:flex;align-items:center;gap:10px}.nav-cta{padding:10px 17px;border:1px solid var(--g500);border-radius:999px;color:var(--g300);font-size:.8rem;font-weight:700;text-decoration:none}.menu-toggle,.menu-check{display:none}
.hero{color:#fff8ef;background:radial-gradient(circle at 80% 15%,rgba(202,165,110,.18),transparent 28rem),linear-gradient(145deg,var(--w950),var(--w800) 55%,var(--w700))}.hero-grid{min-height:720px;display:grid;grid-template-columns:minmax(0,.92fr) minmax(460px,1.08fr);gap:clamp(48px,7vw,100px);align-items:center;padding:84px 0 96px}.eyebrow{display:flex;align-items:center;gap:13px;color:var(--g300);font-size:.74rem;font-weight:700;letter-spacing:.17em;text-transform:uppercase}.eyebrow:before,.eyebrow:after{content:"";width:34px;height:1px;background:currentColor;opacity:.85}.section .eyebrow:after,.history-copy .eyebrow:after,.agenda-title .eyebrow:after{display:none}.hero h1{margin:20px 0 0;font-size:clamp(3.2rem,6vw,6.5rem);line-height:.94;font-weight:600}.hero h1 span{display:block;margin-top:18px;color:var(--g300);font-size:.31em;letter-spacing:.07em;text-transform:uppercase}.hero-lead{color:#ddcdb9;font-size:1.08rem;line-height:1.75}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}.button{display:inline-flex;padding:12px 19px;border:1px solid var(--g500);border-radius:999px;color:var(--w950);background:linear-gradient(135deg,var(--g300),var(--g500));font-weight:700;text-decoration:none}.button.secondary{color:var(--g300);background:transparent}.jubilee-frame{padding:22px;border:1px solid rgba(225,201,159,.42);background:rgba(38,8,11,.36)}.jubilee-art{width:100%;max-height:570px;object-fit:contain}.jubilee-caption{display:flex;justify-content:space-between;padding-top:14px;color:#ccb89d;font-size:.74rem}.ribbon{padding:17px;color:#fff7ec;background:linear-gradient(var(--w700),var(--w950));border-block:1px solid var(--g700);text-align:center;font-weight:700;letter-spacing:.19em;text-transform:uppercase}
.section{padding:110px 0}.loja-intro{display:grid;grid-template-columns:minmax(380px,.95fr) minmax(380px,1.05fr);gap:clamp(54px,7vw,100px);align-items:stretch;margin-bottom:54px}.loja-emblem{position:relative;min-height:410px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start}.loja-ribbon{position:relative;z-index:2;width:min(100%,560px);margin:0 auto -150px}.loja-stamp{position:relative;z-index:1;width:min(72%,330px);transform:translate(-45px,-80px);filter:drop-shadow(0 22px 34px rgba(74,28,23,.22))}.loja-copy{display:flex;flex-direction:column;justify-content:flex-end;align-items:flex-start;max-width:650px;padding-bottom:28px;transform:translateY(-38px)}.loja-copy .eyebrow{color:var(--w700);margin:0 0 24px;text-align:left}.loja-copy p:last-child{margin:0;color:var(--muted);font-size:1.06rem;line-height:1.82;text-align:left}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.card{min-height:270px;padding:29px;border:1px solid var(--line);background:rgba(255,250,241,.72)}.card small{color:var(--g700);font-weight:700;letter-spacing:.16em}.card h3{margin:64px 0 13px;color:var(--w800)}.card p{color:var(--muted)}
.history-band{color:#fff8ef;background:linear-gradient(140deg,var(--w950),var(--w700));border-block:1px solid var(--g700)}.history-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:center}.history-illustration{width:min(390px,82vw);margin:auto}.history-copy h2{margin:0 0 20px;color:#fff8ef;font-size:clamp(2.4rem,5vw,4.8rem);line-height:.98}.history-copy p{margin:0;color:#ddcdb9;line-height:1.78}.history-copy .button{margin-top:34px}.memories{border-bottom:1px solid var(--line)}.section-heading{display:grid;grid-template-columns:.8fr 1.2fr;gap:24px 70px;align-items:end;margin-bottom:52px}.section-heading .eyebrow{grid-column:1/-1;color:var(--w700)}.section-heading h2{margin:0;color:var(--w900);font-size:clamp(2.4rem,5vw,4.8rem);line-height:.98}.section-heading p{color:var(--muted);line-height:1.75}.agenda{display:grid;grid-template-columns:.75fr 1.25fr;gap:48px}.agenda-title{padding:30px;border:1px solid var(--line);background:rgba(255,250,241,.72)}.agenda-list{display:grid;gap:13px}.agenda-item{display:grid;grid-template-columns:96px 1fr auto;gap:20px;align-items:center;padding:22px;border:1px solid var(--line);background:rgba(255,250,241,.7)}.agenda-date{text-align:center;color:var(--w800);border-right:1px solid var(--line)}.agenda-date strong{display:block;font-size:2rem}.agenda-item h3{margin:0;color:var(--w800)}.agenda-item p{margin:6px 0 0;color:var(--muted)}.agenda-status{color:var(--g700);font-size:.72rem;font-weight:700;text-transform:uppercase}.site-footer{color:#ddcdb9;background:var(--w950);border-top:1px solid var(--g700)}.footer-grid{min-height:220px;display:grid;grid-template-columns:1fr auto;align-items:center}.footer-symbol{width:100px;aspect-ratio:1;display:grid;place-items:center;overflow:hidden;border:1px solid var(--g500);border-radius:50%;color:var(--g300)}.footer-logo{width:64px;height:64px}
@media(max-width:980px){.nav{grid-template-columns:minmax(0,1fr) auto}.nav-links{position:absolute;top:100%;left:0;right:0;display:grid;gap:2px;max-height:0;padding:0 18px;overflow:hidden;background:rgba(60,12,17,.99);border-bottom:1px solid transparent;transition:max-height .24s ease,padding .24s ease}.nav-links a{padding:13px 4px;border-radius:6px}.nav-actions{grid-column:2}.menu-toggle{display:flex;flex-direction:column;justify-content:center;gap:5px;width:42px;height:42px;border:1px solid rgba(225,201,159,.45);border-radius:50%;cursor:pointer}.menu-toggle span{width:18px;height:1px;margin-inline:auto;background:var(--g300);transition:.2s}.menu-check:checked~.nav-links{max-height:420px;padding-top:11px;padding-bottom:17px;border-bottom-color:rgba(225,201,159,.25)}.menu-check:checked~.nav-actions .menu-toggle span:first-child{transform:translateY(6px) rotate(45deg)}.menu-check:checked~.nav-actions .menu-toggle span:nth-child(2){opacity:0}.menu-check:checked~.nav-actions .menu-toggle span:last-child{transform:translateY(-6px) rotate(-45deg)}.hero-grid,.history-grid,.agenda{grid-template-columns:1fr}.cards{grid-template-columns:1fr 1fr}.loja-intro{grid-template-columns:1fr;gap:28px}.loja-emblem{min-height:390px}.loja-copy{max-width:760px;padding-bottom:0}}
@media(max-width:650px){:root{--shell:calc(100vw - 26px)}.nav{min-height:70px;gap:10px}.brand-copy span{display:none}.brand-copy strong{font-size:.72rem}.nav-actions{gap:7px}.nav-cta{padding:9px 12px;font-size:.73rem}.menu-toggle{width:39px;height:39px}.hero-grid{padding:60px 0 70px}.hero h1{font-size:3.2rem}.section{padding:80px 0}.section-heading,.cards{grid-template-columns:1fr}.loja-emblem{min-height:300px}.loja-ribbon{width:100%;margin-bottom:-34px;transform:translateX(-24px)}.loja-stamp{width:min(76%,260px)}.history-illustration{width:100%;max-width:none;margin:0}.agenda-item{grid-template-columns:72px 1fr}.agenda-status{grid-column:2}.footer-grid{grid-template-columns:1fr;padding:55px 0}}
@media(max-width:430px){.brand-copy{display:none}.brand-mark{width:40px;height:40px}.nav-cta{padding-inline:11px}.hero h1{font-size:2.85rem}}
</style>
</head>
<body>
<header class="site-header"><nav class="nav shell"><a class="brand" href="#inicio"><span class="brand-mark" aria-hidden="true"><img class="brand-logo" src="template/image/loja-logo.svg" alt=""></span><span class="brand-copy"><strong>{{ brand.name }}</strong><span>{{ brand.subtitle }}</span></span></a><input class="menu-check" id="menu-check" type="checkbox"><div class="nav-links">{% for item in navigation %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}</div><div class="nav-actions"><a class="nav-cta" href="{{ login.href }}">{{ login.label }}</a><label class="menu-toggle" for="menu-check" aria-label="Abrir menu"><span></span><span></span><span></span></label></div></nav></header>
<main>
<section class="hero" id="inicio"><div class="hero-grid shell"><div><p class="eyebrow">{{ hero.eyebrow }}</p><h1>{{ hero.title }}<span>{{ hero.subtitle }}</span></h1><p class="hero-lead">{{ hero.lead }}</p><div class="hero-actions"><a class="button" href="{{ hero.primary.href }}">{{ hero.primary.label }}</a><a class="button secondary" href="{{ hero.secondary.href }}">{{ hero.secondary.label }}</a></div></div><figure class="jubilee-frame"><img class="jubilee-art" src="{{ hero.image }}" alt="{{ hero.image_alt }}"><figcaption class="jubilee-caption"><span>{{ hero.caption_left }}</span><span>{{ hero.caption_right }}</span></figcaption></figure></div></section>
<div class="ribbon">{{ ribbon }}</div>
<section class="section shell" id="loja"><div class="loja-intro"><div class="loja-emblem" aria-hidden="true"><img class="loja-ribbon" src="template/image/fita.png" alt=""><img class="loja-stamp" src="template/image/carimbo.png" alt=""></div><div class="loja-copy"><p class="eyebrow">{{ sections.intro.eyebrow }}</p><p>{{ sections.intro.lead }}</p></div></div><div class="cards">{% for card in sections.intro.cards %}<article class="card"><small>{{ card.number }}</small><h3>{{ card.title }}</h3><p>{{ card.body }}</p></article>{% endfor %}</div></section>
<section class="history-band" id="historia"><div class="section history-grid shell"><img class="history-illustration" src="template/image/templo.png" alt="Ilustração do templo maçônico"><div class="history-copy"><p class="eyebrow">{{ sections.history.eyebrow }}</p><h2>{{ sections.history.title }}</h2><p>{{ sections.history.body }}</p><a class="button" href="{{ sections.history.link.href }}">{{ sections.history.link.label }}</a></div></div></section>
<section class="section memories" id="memorias"><div class="section-heading shell"><p class="eyebrow">{{ sections.memories.eyebrow }}</p><h2>{{ sections.memories.title }}</h2><p>{{ sections.memories.lead }}</p></div></section>
<section class="section shell" id="agenda"><div class="agenda"><div class="agenda-title"><p class="eyebrow">{{ sections.agenda.eyebrow }}</p><h2>{{ sections.agenda.title }}</h2><p>{{ sections.agenda.lead }}</p></div><div class="agenda-list">{% for item in sections.agenda["items"] %}<article class="agenda-item"><div class="agenda-date"><strong>{{ item.day }}</strong><span>{{ item.month }}</span></div><div><h3>{{ item.title }}</h3><p>{{ item.body }}</p></div><span class="agenda-status">{{ item.status }}</span></article>{% endfor %}</div></div></section>
</main>
<footer class="site-footer" id="contato"><div class="footer-grid shell"><div><h2>{{ footer.title }}</h2><p>{{ footer.body }}</p></div><div class="footer-symbol" aria-hidden="true"><img class="footer-logo" src="template/image/loja-logo.svg" alt=""></div></div></footer>
</body></html>
